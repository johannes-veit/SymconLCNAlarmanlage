        },
        {
            "type": "SelectInstance",
            "name": "SMTPInstanceID",
            "caption": "SMTP-Instanz"
        },
        {
            "type": "ValidationTextBox",
            "name": "EmailRecipients",
            "caption": "E-Mail-Empfänger (; oder , getrennt)"
        },
        {
            "type": "Label",
            "label": "Die Empfänger werden nur in der Symcon-Instanzkonfiguration gespeichert und nicht im Modul-Repository. Jede Adresse erhält pro Alarm-Session genau eine E-Mail. Ein Ausfall von Push/SMTP legt den Alarmkern nicht still; Fehler werden protokolliert."
        },
        {
            "type": "CheckBox",
            "name": "TVEnabled",
            "caption": "Samsung-TV bei Alarm einschalten"
        },
        {
            "type": "SelectVariable",
            "name": "TVStatusVariableID",
            "caption": "Samsung-TV – Status (Boolean)",
            "validVariableTypes": [
                0
            ]
        },
        {
            "type": "SelectVariable",
            "name": "TVPowerButtonVariableID",
            "caption": "Samsung-TV – Ein/Aus Impulsbutton (PowerFix)",
            "validVariableTypes": [
                1
            ]
        },
        {
            "type": "Label",
            "label": "Verwendet den bestehenden Samsung Tizen PowerFix: Status ist die reale EIN/AUS-Booleanvariable, Ein/Aus ist der von PowerFix erzeugte Integer-Impulsbutton. Bei Alarm wird der TV nur bei bestätigtem AUS eingeschaltet. Nach Alarmende wird AUS angefordert und anschließend 10-sekündlich maximal 60 s lokal kontrolliert; ein verspätet hochfahrender TV wird dadurch ebenfalls wieder ausgeschaltet. Keine Endlosschleife und kein zusätzliches TV-Polling durch die Alarmanlage."
        },
        {
            "type": "NumberSpinner",
            "name": "AlarmDurationSeconds",
            "caption": "Alarmdauer bis automatische Abschaltung (Sekunden)",
            "minimum": 10,
            "maximum": 3600
        },
        {
            "type": "NumberSpinner",
            "name": "RearmDelaySeconds",
            "caption": "Verzögerung bis erneut scharf nach Alarmende (Sekunden)",
            "minimum": 0,
            "maximum": 3600
        },
        {
            "type": "Label",
            "label": "Die Zeitautomatik wird in der Visualisierung über Automatik, Scharf ab und Unscharf ab eingestellt. Manuelle Bedienung überschreibt die Automatik bis zur nächsten Zeitgrenze."
        }
    ],
    "actions": [
        {
            "type": "Label",
            "label": "Kein LCN-Polling: GUS und Panik-Lichter werden ausschließlich über spontane VM_UPDATE-Meldungen ausgewertet. Push/E-Mail laufen nur beim ersten Trigger. Die Samsung-TV-Nachkontrolle liest nur die lokale PowerFix-Statusvariable und erzeugt selbst kein zusätzliches TV-Polling."
        }
    ]
